{
  "name": "@local/dsh-work-team",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/",
    "measure": "node scripts/measure-context.mjs",
    "link:host-deps": "node scripts/link-host-deps.mjs"
  },
  "description": "Boss-view work team for DSH: role-based teammates, per-role models, live office UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "scripts/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keeptrue/dsh-work-team.git"
  },
  "engines": {
    "node": ">=20"
  }
}
